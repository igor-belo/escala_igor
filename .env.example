# ===================================
# EXEMPLO DE CONFIGURAÇÃO
# Copie para .env e preencha os valores
# NUNCA commite o arquivo .env real!
# ===================================

# Porta do servidor
PORT=3000

# Ambiente (development ou production)
NODE_ENV=production

# Chave de criptografia (gere uma nova com: openssl rand -hex 32)
CRYPTO_KEY=sua_chave_de_32_caracteres_aqui

# ===================================
# SUPABASE (Banco de Dados na Nuvem)
# ===================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_publishable_key_aqui
SUPABASE_CONNECTION_STRING=postgresql://postgres.[projeto]:[senha]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ===================================
# GOOGLE OAUTH (Opcional)
# ===================================
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret

# ===================================
# INTEGRAÇÃO BIMER (Opcional)
# ===================================
BIMER_USER=seu_usuario
BIMER_PASS=sua_senha

# ===================================
# BANCO LOCAL (Apenas para Desenvolvimento)
# ===================================
PGUSER=postgres
PGPASSWORD=sua_senha_local
PGHOST=localhost
PGPORT=5432
PGDATABASE=escala
