{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/notificacoes",
      "schedule": "0 8 * * *"
    }
  ],
  "builds": [
    {
      "src": "api/health.js",
      "use": "@vercel/node"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
